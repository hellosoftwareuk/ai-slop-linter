{
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "slop codex hook",
            "statusMessage": "Scanning changed code with Slop",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "Edit|Write|apply_patch"
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "slop codex hook",
            "statusMessage": "Checking this turn for new slop",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "command": "slop codex hook",
            "statusMessage": "Capturing Slop baseline",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ]
  }
}
